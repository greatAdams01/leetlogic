{
  "name": "@leetlogic/database",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "exports": { ".": "./dist/src/index.js" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src prisma",
    "test": "vitest run --passWithNoTests",
    "generate": "prisma generate",
    "migrate": "prisma migrate dev",
    "seed:catalogue": "node --env-file-if-exists=../../.env --import tsx prisma/seed-catalogue.ts",
    "seed": "node --env-file-if-exists=../../.env --import tsx prisma/seed.ts"
  },
  "dependencies": { "@prisma/client": "^6.0.0" },
  "devDependencies": { "prisma": "^6.0.0", "tsx": "^4.20.0" }
}

