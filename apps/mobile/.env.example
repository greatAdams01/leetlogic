# iOS simulator: localhost; Android emulator defaults to 10.0.2.2 automatically.
# Physical device: your computer's LAN IP, never a public tunnel with console OTP.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Deployed web origin; local emulator defaults to the API host on port 3001.
EXPO_PUBLIC_WEB_URL=
# Optional overrides for approved, published HTTPS policy pages.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
