# Expo Go LAN mode automatically uses the Metro computer host on port 3000.
# Optional override: a reachable API origin (no /v1 suffix).
# Use the same Wi-Fi; a Metro tunnel does not forward the backend.
# EXPO_PUBLIC_API_URL=http://192.168.1.10:3000

# Deployed web origin; local emulator defaults to the API host on port 3001.
EXPO_PUBLIC_WEB_URL=
# Optional overrides for approved, published HTTPS policy pages.
EXPO_PUBLIC_TERMS_URL=
EXPO_PUBLIC_PRIVACY_URL=
