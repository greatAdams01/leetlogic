{
  "name": "@leetlogic/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "node --env-file=../../.env --import tsx --watch src/server.ts",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "lint": "eslint src",
    "test": "vitest run",
    "test:identity": "node --env-file=../../.env scripts/test-identity.mjs",
    "test:delivery": "node --env-file=../../.env scripts/test-delivery.mjs",
    "test:admin": "node --env-file=../../.env scripts/test-admin.mjs",
    "worker:payments": "node --env-file=../../.env --import tsx src/payment-jobs.ts",
    "test:payments": "node --env-file=../../.env scripts/test-payments.mjs",
    "media:check": "node --env-file=../../.env --import tsx src/media-check.ts"
  },
  "dependencies": {
    "@leetlogic/contracts": "workspace:*",
    "@leetlogic/database": "workspace:*",
    "@leetlogic/localization": "workspace:*",
    "@types/cors": "^2.8.0",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.0",
    "@types/swagger-ui-express": "^4.1.0",
    "cloudinary": "^2.11.0",
    "cors": "^2.8.0",
    "express": "^5.1.0",
    "helmet": "^8.0.0",
    "ioredis": "^5.6.0",
    "jsonwebtoken": "^9.0.0",
    "otplib": "^12.0.0",
    "pino": "^9.0.0",
    "pino-http": "^10.0.0",
    "swagger-ui-express": "^5.0.0",
    "zod": "^3.25.0"
  },
  "devDependencies": {
    "@types/supertest": "^6.0.0",
    "supertest": "^7.1.0",
    "tsx": "^4.20.0"
  }
}
