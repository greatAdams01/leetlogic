NODE_ENV=development
# Optional: json for machine-readable logs in development; production is always JSON.
LOG_FORMAT=pretty
LOG_LEVEL=info
PORT=3000
DATABASE_URL=postgresql://leetlogic:leetlogic@localhost:5432/leetlogic?schema=public
REDIS_URL=redis://localhost:6379
ACCESS_TOKEN_SECRET=replace-with-at-least-32-characters
ADMIN_ACCESS_TOKEN_SECRET=replace-with-a-different-32-character-secret
TOKEN_HASH_SECRET=replace-with-a-different-32-character-secret
TOTP_ENCRYPTION_KEY=base64-encoded-32-byte-key
OTP_PROVIDER=console
TERMII_API_KEY=
TERMII_SENDER_ID=Leetlogic
AFRICAS_TALKING_API_KEY=
AFRICAS_TALKING_USERNAME=
AFRICAS_TALKING_SENDER_ID=Leetlogic
EMAIL_PROVIDER=console
RESEND_API_KEY=
ADMIN_EMAIL_FROM=LeetLogic <admin@leetlogic.ng>
PRIVATE_STORAGE_ROOT=.private-objects
ADMIN_WEB_URL=http://localhost:3001
ADMIN_API_URL=http://localhost:3000
BOOTSTRAP_ADMIN_EMAIL=
BOOTSTRAP_ADMIN_NAME=


# Delivery pilot: use a Shipbubble dashboard test key; live bookings require a separate switch.
DELIVERY_ENABLED=false
SHIPBUBBLE_MODE=test
SHIPBUBBLE_TEST_KEY_CONFIRMED=false
SHIPBUBBLE_API_KEY=
SHIPBUBBLE_CATEGORY_ID=
DELIVERY_LIVE_BOOKINGS=false
# Confirm eligible local category UUIDs and Nigerian state names with the carrier before enabling.
DELIVERY_ALLOWED_CATEGORIES=
DELIVERY_ALLOWED_STATES=
DELIVERY_MAX_WEIGHT_KG=20

# Azure Translator F0 only. Configure an F0 resource in Azure; never upgrade automatically.
TRANSLATION_ENABLED=false
AZURE_TRANSLATOR_KEY=
AZURE_TRANSLATOR_REGION=
TRANSLATION_MONTHLY_CAP=1900000
# Voice remains disabled until a free hosted Igbo service passes the documented acceptance gate.

# Identity verification: Dojah EasyOnboard, sandbox first. Credentials stay server-side.
IDENTITY_PROVIDER=dojah
DOJAH_ENABLED=false
DOJAH_MODE=sandbox
DOJAH_APP_ID=
DOJAH_SECRET_KEY=
DOJAH_WIDGET_ID=
# The subscription's webhook secret, NOT the API secret key.
DOJAH_WEBHOOK_SECRET=
# Set true only after configuring name match, government ID/face match and liveness.
DOJAH_FLOW_POLICY_CONFIRMED=false
DOJAH_LIVE_CHECKS=false
